{
  "$defs": {
    "ClosedMetrics": {
      "additionalProperties": false,
      "description": "The only public aggregate metrics permitted in a fold receipt.",
      "properties": {
        "row_count": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Count"
        },
        "stable_mae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stable Mae"
        },
        "candidate_mae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Mae"
        },
        "point_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Point Ratio"
        },
        "ucb95": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ucb95"
        }
      },
      "required": [
        "row_count",
        "stable_mae",
        "candidate_mae",
        "point_ratio",
        "ucb95"
      ],
      "title": "ClosedMetrics",
      "type": "object"
    },
    "PrivateBundleIdentity": {
      "additionalProperties": false,
      "description": "The deliberately narrow public identity of private published files.",
      "properties": {
        "file_count": {
          "title": "File Count",
          "type": "integer"
        },
        "total_bytes": {
          "title": "Total Bytes",
          "type": "integer"
        },
        "inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Inventory Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "file_count",
        "total_bytes",
        "inventory_sha256",
        "manifest_sha256"
      ],
      "title": "PrivateBundleIdentity",
      "type": "object"
    },
    "PublicDevelopmentResult": {
      "additionalProperties": false,
      "description": "Public-only, schema-closed receipt for one development inventory.",
      "properties": {
        "schema_version": {
          "const": "mdcp.development-result-index.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "RFC8785",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "synthetic_test",
            "natural_development"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "h1_role": {
          "const": "OBSERVED_DEVELOPMENT_ONLY",
          "title": "H1 Role",
          "type": "string"
        },
        "h2_state": {
          "const": "SEALED_NOT_LOADED",
          "title": "H2 State",
          "type": "string"
        },
        "h2_loaded_rows": {
          "const": 0,
          "title": "H2 Loaded Rows",
          "type": "integer"
        },
        "selection_fit_count": {
          "const": 80,
          "title": "Selection Fit Count",
          "type": "integer"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
