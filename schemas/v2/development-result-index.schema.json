            "TRIAL-15",
            "TRIAL-16",
            "TRIAL-17",
            "TRIAL-18",
            "TRIAL-19",
            "TRIAL-20"
          ],
          "title": "Trial Id",
          "type": "string"
        },
        "selection_fit_count": {
          "const": 4,
          "title": "Selection Fit Count",
          "type": "integer"
        },
        "folds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/PublicFoldReceipt"
            },
            {
              "$ref": "#/$defs/PublicFoldReceipt"
            },
            {
              "$ref": "#/$defs/PublicFoldReceipt"
            },
            {
              "$ref": "#/$defs/PublicFoldReceipt"
            }
          ],
          "title": "Folds",
          "type": "array"
