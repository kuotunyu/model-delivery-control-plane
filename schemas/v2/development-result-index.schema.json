    "PublicFoldReceipt": {
      "additionalProperties": false,
      "description": "One closed four-fold public receipt.",
      "properties": {
        "fold_id": {
          "enum": [
            "F1",
            "F2",
            "F3",
            "F4"
          ],
          "title": "Fold Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/ClosedMetrics"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "METRICS_UNAVAILABLE",
              "QUALITY_THRESHOLD_EXCEEDED"
            ],
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "fold_id",
        "status",
        "metrics",
        "reason_codes"
      ],
      "title": "PublicFoldReceipt",
      "type": "object"
    },
    "PublicTrialReceipt": {
      "additionalProperties": false,
      "description": "A trial has exactly one fit per closed fold.",
      "properties": {
        "trial_id": {
          "enum": [
            "TRIAL-01",
            "TRIAL-02",
            "TRIAL-03",
            "TRIAL-04",
            "TRIAL-05",
            "TRIAL-06",
            "TRIAL-07",
            "TRIAL-08",
            "TRIAL-09",
            "TRIAL-10",
            "TRIAL-11",
            "TRIAL-12",
            "TRIAL-13",
