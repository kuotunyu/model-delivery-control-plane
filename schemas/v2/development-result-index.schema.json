            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selection_status": {
            "const": "PASS"
          }
        },
        "required": [
          "selection_status"
        ]
      },
      "then": {
        "properties": {
          "fit_count": {
            "const": 84
          },
          "development_result": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selection_status": {
            "const": "NO_ELIGIBLE_CANDIDATE"
          }
        },
        "required": [
          "selection_status"
        ]
      },
      "then": {
        "properties": {
          "fit_count": {
            "const": 80
          },
          "development_result": {
            "properties": {
              "status": {
                "const": "FAIL"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selection_status": {
            "const": "UNKNOWN/NO_ELIGIBLE_CANDIDATE"
          }
        },
        "required": [
          "selection_status"
        ]
      },
      "then": {
        "properties": {
          "fit_count": {
            "enum": [
              80,
              84
            ]
          },
          "development_result": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            }
          }
        }
      }
