      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "route_revision": {
      "exclusiveMinimum": 0,
      "title": "Route Revision",
      "type": "integer"
    },
    "traceparent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceparent"
    }
  },
  "required": [
    "request_id",
    "release_id",
    "prediction",
    "route_revision"
  ],
  "title": "PredictionResponse",
  "type": "object"
